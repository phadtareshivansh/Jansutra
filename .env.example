# Backend-only secrets (NEVER expose these to the frontend)

# Firebase service account credentials (from the service account JSON you download in Firebase console)
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# OpenRouter API key (used by the /api/ask GenAI endpoint)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

PORT=3001
