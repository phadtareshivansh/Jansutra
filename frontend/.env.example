# Frontend (PUBLIC/safe-to-expose) Firebase config.
# These VITE_FIREBASE_* values come from the "Firebase web app config" object
# in Firebase console -> Project settings -> Your apps -> SDK setup and configuration.
# They are NOT secrets — safe to expose to the browser.
#
# Only needed if you want Google sign-in / Firebase Auth in the browser.
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
